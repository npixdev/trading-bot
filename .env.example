# Copier ce fichier en .env et remplir. .env n'est JAMAIS commité (voir .gitignore).

# Alertes Telegram (optionnel) — voir README, section « Alertes Telegram »
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Guide de création des clés : docs/CLES_API.md
# Règles : AUCUN droit de retrait, restriction par IP si possible, sous-compte dédié au bot.

# Clés du testnet spot Binance (fonds fictifs, sans KYC) — utilisées par : python -m bot trade
# À créer sur https://testnet.binance.vision (clé « HMAC » : une API key + un secret)
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# (Alternative) Clés du mode démo OKX — python -m bot trade --exchange okx --symbol BTC/USDC
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSWORD=

# Clés réelles OKX — utilisées UNIQUEMENT par : python -m bot trade --live (+ confirmation)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
